<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/birthday_bg"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/center_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/photo_image_view"
            android:layout_width="250dp"
            android:layout_height="240dp"
            android:src="@drawable/birthday_cake"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/title_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/birthday_title"
            android:textColor="#52e2ff"
            android:textStyle="bold"
            android:textSize="24sp"
            android:fontFamily="@font/birthday"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/text_normal_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/birthday_phrase"
            android:textColor="#3796f0"
            android:textSize="16sp"
            android:fontFamily="@font/beachday"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

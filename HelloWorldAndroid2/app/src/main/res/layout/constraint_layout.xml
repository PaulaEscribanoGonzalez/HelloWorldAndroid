<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Imagen arriba -->
    <ImageView
        android:id="@+id/photo_image_view"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_launcher_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Título debajo de la imagen -->
    <TextView
        android:id="@+id/title_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Hola"
        android:textAppearance="?android:textAppearanceLarge"
        android:textColor="#4689C8"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/photo_image_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Texto 2025 -->
    <TextView
        android:id="@+id/text_2025"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="2025"
        android:textSize="16sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/title_text_view"
        app:layout_constraintEnd_toStartOf="@id/text_lorem"/>

    <!-- Texto Lorem Ipsum -->
    <TextView
        android:id="@+id/text_lorem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Lorem Ipsum"
        android:textSize="16sp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toBottomOf="@id/title_text_view"
        app:layout_constraintStart_toEndOf="@id/text_2025"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- "Hola" 1 -->
    <TextView
        android:id="@+id/text_hola_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Hola"
        android:textSize="16sp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/text_lorem"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- "Hola" 2 -->
    <TextView
        android:id="@+id/text_hola_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Hola"
        android:textSize="16sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/text_hola_1"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Botón centrado -->
    <Button
        android:id="@+id/next_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Next"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/text_hola_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
